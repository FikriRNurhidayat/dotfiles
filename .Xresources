! XFT
Xft.antialias:	1
Xft.hinting:	1
Xft.autohint:	0
Xft.hintstyle:	hintslight
Xft.rgba:	rgb
Xft.lcdfilter:	lcddefault

! dwm
dwm.font: monospace:style=bold:hinting=true:antialias=true:size=10

! dmenu
dmenu.font: monospace:style=bold:hinting=true:antialias=true:size=10
dmenu.center: 1
dmenu.vertpad: 16

! st
st.font: monospace:style=bold:hinting=true:antialias=true:size=10
st.borderpx: 24

! sent
sent.font: monospace:style=bold:hinting=true:antialias:true, Symbols Nerd Font:antialias=true:hinting=true

Xcursor.theme: "catppuccin-mocha-green-standard+default"

emacs.font: monospace-10
